# Copy to .env and adjust. Every variable is optional except COMMIT_SHA;
# unset variables fall back to src/config/config.yaml.

# --- Traceability (required by src/training/train.py) ---
# Git commit of the code being trained. In CI use ${GITHUB_SHA}; locally: git rev-parse HEAD
COMMIT_SHA=local-dev

# --- MLflow ---
# Local server: http://localhost:5050 | VM1 server: http://<vm1-host>:5050 | No server: sqlite:///mlflow.db
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_EXPERIMENT_NAME=flight-delay-severity
MLFLOW_MODEL_NAME=flight-delay-classifier

# --- Data ---
# Path to the cleaned CSV, relative to the project root
DATA_PATH=src/data/processed/cleaned_flights_data.csv

# Sample sizes per partition. Use "all" (or "none"/"null") for the full partition.
TRAIN_SAMPLE_SIZE=500000
VALIDATION_SAMPLE_SIZE=200000
TEST_SAMPLE_SIZE=500000

# --- Training ---
# Comma-separated keys from the "models" section of config.yaml
ENABLED_MODELS=random_forest,logistic_regression
TRAINING_OUTPUT_DIR=artifacts/training
